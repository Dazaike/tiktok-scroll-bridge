{
  "manifest_version": 3,
  "name": "TikTok Background Scroll Bridge",
  "version": "1.0.1",
  "minimum_chrome_version": "116",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "http://127.0.0.1:38421/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
